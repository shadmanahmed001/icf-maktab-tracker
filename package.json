{
  "name": "icf-maktab-tracker",
  "version": "1.0.0",
  "description": "Islamic Center of Fremont (ICF) Daily Maktab — academic standards tracker with admin, teacher and parent portals",
  "main": "server/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently -n server,client -c cyan,magenta \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "seed": "node server/seed/index.js",
    "reseed": "rm -f server/maktab.db && node server/seed/index.js",
    "test": "node --test tests/api.test.js",
    "test:e2e": "node tests/browser.test.js",
    "test:all": "npm test && npm run test:e2e",
    "lint": "npm --prefix client run lint",
    "demo": "npm run demo:fixtures && npm run demo:build && npm run demo:page && npm run demo:verify",
    "demo:fixtures": "node scripts/capture-demo-fixtures.js",
    "demo:build": "npm --prefix client run build:demo",
    "demo:page": "node scripts/build-demo-artifact.js",
    "demo:verify": "node scripts/verify-demo.js"
  },
  "keywords": [
    "maktab",
    "islamic-studies",
    "icf",
    "syllabus-tracker",
    "lesson-planner"
  ],
  "author": "shadmanahmed001",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "sql.js": "^1.14.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "playwright": "^1.62.1"
  }
}
