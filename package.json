{
  "name": "icf-maktab-tracker",
  "version": "1.0.0",
  "description": "Islamic Center of Fremont (ICF) Maktab Daily Lesson Plan & Progress Tracker",
  "main": "server/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "seed": "node server/seed.js",
    "client:dev": "npm --prefix client run dev",
    "server:dev": "node server/index.js",
    "dev": "npm run build && node server/index.js"
  },
  "keywords": [
    "maktab",
    "islamic-studies",
    "icf",
    "syllabus-tracker",
    "lesson-planner"
  ],
  "author": "shadmanahmed001",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "morgan": "^1.10.1",
    "sql.js": "^1.14.0"
  }
}
