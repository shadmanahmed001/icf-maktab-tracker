# Copy to .env and adjust. Every value here has a working default, so the
# application starts with no configuration at all — but a real deployment
# should at minimum set JWT_SECRET and turn DEMO_MODE off.

# Port the server listens on.
PORT=3001

# Where the SQLite database lives. Back this single file up and you have
# backed up the entire maktab record.
DB_PATH=./server/maktab.db

# Signing secret for session cookies. If unset, one is generated and stored in
# the database — fine for a single instance, but set it explicitly when running
# more than one, or sessions will not carry between them.
JWT_SECRET=

# How long a sign-in lasts, in hours.
SESSION_HOURS=12

# Shows the demonstration account list on the sign-in screen. Set to false
# before the real rollout so seeded accounts are not advertised.
DEMO_MODE=true

# The shared password for the seeded demonstration accounts.
DEMO_PASSWORD=maktab2027

# Rate limits. LOGIN_ATTEMPTS is per IP per 15 minutes; API_RATE_LIMIT is
# per IP per minute across the whole API.
LOGIN_ATTEMPTS=20
API_RATE_LIMIT=600

NODE_ENV=production
